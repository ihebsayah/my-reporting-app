APP_NAME=PFE Reporting App
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/reporting_app.db
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=change-me
LABEL_STUDIO_PROJECT_TITLE=Invoice Field Extraction
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Africa/Tunis
LOG_LEVEL=INFO
AUTO_APPROVAL_THRESHOLD=0.90
REVIEW_MIN_THRESHOLD=0.70
REVIEW_MAX_THRESHOLD=0.89
NER_MODEL_OUTPUT_DIR=artifacts/models/ner
NER_TRAIN_ITERATIONS=20
NER_MODEL_PATH=artifacts/models/ner
PIPELINE_VERSION=sequential-v1
EXTRACTION_VERSION=regex-spacy-ensemble-v1
MODEL_VERSION=untrained-regex-fallback
FIELD_THRESHOLDS_JSON={"INVOICE_ID":{"auto":0.92,"review_min":0.72,"review_max":0.91},"INVOICE_DATE":{"auto":0.90,"review_min":0.70,"review_max":0.89},"TOTAL_AMOUNT":{"auto":0.95,"review_min":0.80,"review_max":0.94},"VENDOR_NAME":{"auto":0.88,"review_min":0.68,"review_max":0.87}}

# ── AI Agent Service (port 8001) ───────────────────────────────────────────────
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8001
AGENT_SERVICE_VERSION=0.1.0
AGENTS_ENABLED=true

# URL of the existing FastAPI pipeline (agents call it as a tool)
API_BASE_URL=http://localhost:8000

# Ollama LLM settings (run: ollama pull mistral)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=mistral
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=60

# Redis (for real-time agent memory — optional, agents degrade gracefully without it)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=604800
REDIS_PATTERN_TTL_SECONDS=2592000

# Agent routing thresholds
AGENT_AUTO_APPROVE_THRESHOLD=0.85
AGENT_HUMAN_REVIEW_THRESHOLD=0.65

# Safety rails
SAFETY_MAX_AMOUNT=100000

# Auto-rollback triggers
ROLLBACK_ACCURACY_THRESHOLD=0.85
ROLLBACK_OVERRIDE_RATE_THRESHOLD=0.30
ROLLBACK_WINDOW_SIZE=100

# Logging
LOG_AGENT_REASONING=true
AGENT_LOG_DIR=artifacts/agent_logs
